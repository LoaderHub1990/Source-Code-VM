LoadButton.MouseButton1Click:Connect(function()
    if IsLoading then
        return
    end
    IsLoading = true

    local URL = tostring(URLBox.Text or "")
    URL = URL:gsub("^%s+", "")
    URL = URL:gsub("%s+$", "")

    if URL == "" then
        SetStatus("กรุณาใส่ URL ก่อน", COLOR_ERROR)
        LoadButton.Text = "LOAD"
        IsLoading = false
        return
    end

    ClearSession()
    SetStatus("กำลังโหลด...", COLOR_WHITE)
    LoadButton.Text = "LOADING"

    AddLog("เริ่มโหลด URL")
    AddLog(URL)

    InstallLoadstringHook()
    InstallHttpHook()

    local HttpSuccess, Result = pcall(function()
        return game:HttpGet(URL, true)
    end)

    if not HttpSuccess then
        SafeSetText(CodeBox, "-- HttpGet Error:\n\n" .. tostring(Result))
        AddLog("HttpGet Error: " .. tostring(Result), true)
        SetStatus("โหลดไม่สำเร็จ", COLOR_ERROR)
        LoadButton.Text = "LOAD"
        IsLoading = false
        return
    end

    Result = tostring(Result or "")

    if Result == "" then
        SafeSetText(CodeBox, "-- Source ว่าง")
        AddLog("HttpGet สำเร็จ แต่ Source ว่าง", true)
        SetStatus("Source ว่าง", COLOR_ERROR)
        LoadButton.Text = "LOAD"
        IsLoading = false
        return
    end

    AddLog("HttpGet สำเร็จ: " .. tostring(#Result) .. " bytes")

    -- ถ้า HttpGet hook จับไว้แล้ว AddStage จะไม่เพิ่มซ้ำ
    AddStage("ROOT", Result)

    SetStatus("โหลด Source สำเร็จ", COLOR_SUCCESS)
    LoadButton.Text = "RUNNING"

    if ExecuteRootSource(Result) then
        SetStatus("Execute สำเร็จ — " .. tostring(#Stages) .. " stage", COLOR_SUCCESS)
        LoadButton.Text = "DONE"
    else
        SetStatus("Execute มี Error", COLOR_ERROR)
        LoadButton.Text = "ERROR"
    end

    IsLoading = false
end)

