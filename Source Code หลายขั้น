local function CopyText(Text, Button, IdleText, OkStatus)
    if Text == "" then
        SetStatus("ยังไม่มีข้อมูลให้คัดลอก", COLOR_WARNING)
        return
    end

    if not setclipboard then
        SetStatus("Executor ไม่รองรับ Clipboard", COLOR_WARNING)
        return
    end

    local Ok, Err = pcall(setclipboard, Text)

    if Ok then
        Button.Text = "COPIED"
        if OkStatus then
            SetStatus(OkStatus, COLOR_SUCCESS)
        end
        task.delay(1.2, function()
            if Button and Button.Parent then
                Button.Text = IdleText
            end
        end)
    else
        SetStatus("Copy ไม่สำเร็จ: " .. tostring(Err), COLOR_WARNING)
    end
end

