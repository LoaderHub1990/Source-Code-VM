-- ===== state =====

local Stages = {}          -- { {Name = string, Source = string}, ... }
local SeenSources = {}     -- กันซอสซ้ำ
local StageIndex = 1
local PageIndex = 1
local PageCount = 0
local LoadLogs = {}
local IsLoading = false
local NestedCounter = 0

local function SetStatus(Text, Color)
    if Status and Status.Parent then
        Status.Text = tostring(Text)
        Status.TextColor3 = Color or COLOR_MUTED
    end
end

local function SafeSetText(Object, Text)
    Text = tostring(Text or "")
    if #Text >= 199000 then
        Text = Text:sub(1, 198000)
    end
    pcall(function()
        Object.Text = Text
    end)
end

local function RefreshLog()
    local Text = table.concat(LoadLogs, "\n")
    if #Text > MAX_LOG_DISPLAY then
        Text = Text:sub(#Text - MAX_LOG_DISPLAY + 1)
    end
    SafeSetText(LogBox, Text)

    task.defer(function()
        if LogScroll and LogScroll.Parent then
            pcall(function()
                LogScroll.CanvasPosition = Vector2.new(
                    0,
                    math.max(0, LogScroll.AbsoluteCanvasSize.Y - LogScroll.AbsoluteSize.Y)
                )
            end)
        end
    end)
end

local function AddLog(Message, IsError)
    Message = tostring(Message or "")
    table.insert(LoadLogs, os.date("%H:%M:%S") .. "  " .. Message)
    RefreshLog()
    if IsError then
        SetStatus(Message, COLOR_ERROR)
    end
end

local function CurrentStage()
    return Stages[StageIndex]
end

local function RefreshSourcePage()
    local Stage = CurrentStage()

    StageLabel.Text = "STAGE " .. tostring(#Stages > 0 and StageIndex or 0) .. " / " .. tostring(#Stages)

    if not Stage or Stage.Source == "" then
        SafeSetText(CodeBox, "-- ยังไม่มี source")
        PageLabel.Text = "PAGE 0 / 0"
        PageCount = 0
        return
    end

    local Source = Stage.Source

    PageCount = math.max(1, math.ceil(#Source / MAX_SOURCE_DISPLAY))
    PageIndex = math.clamp(PageIndex, 1, PageCount)

    local StartIndex = ((PageIndex - 1) * MAX_SOURCE_DISPLAY) + 1
    local EndIndex = math.min(StartIndex + MAX_SOURCE_DISPLAY - 1, #Source)

    SafeSetText(CodeBox, Source:sub(StartIndex, EndIndex))
    PageLabel.Text = "PAGE " .. tostring(PageIndex) .. " / " .. tostring(PageCount)

    task.defer(function()
        if CodeScroll and CodeScroll.Parent then
            CodeScroll.CanvasPosition = Vector2.new(0, 0)
        end
    end)
end

local function GoToStage(Index)
    if #Stages == 0 then
        return
    end
    StageIndex = math.clamp(Index, 1, #Stages)
    PageIndex = 1
    RefreshSourcePage()
end

-- เพิ่ม stage ใหม่ (ซ้ำจะไม่เพิ่ม) คืนค่า index
local function AddStage(Name, Source)
    Source = tostring(Source or "")

    if Source == "" then
        return nil
    end

    if SeenSources[Source] then
        return SeenSources[Source]
    end

    table.insert(Stages, {Name = Name, Source = Source})
    SeenSources[Source] = #Stages

    AddLog("Captured stage " .. tostring(#Stages) .. ": " .. tostring(Name) .. " (" .. tostring(#Source) .. " bytes)")

    -- stage แรกให้แสดงเลย, stage ถัดไปแค่อัปเดตตัวนับ (ไม่แย่งหน้าจอ)
    if #Stages == 1 then
        StageIndex = 1
        PageIndex = 1
    end
    RefreshSourcePage()

    return #Stages
end

local function ClearSession()
    Stages = {}
    SeenSources = {}
    StageIndex = 1
    PageIndex = 1
    PageCount = 0
    NestedCounter = 0
    LoadLogs = {}

    StageLabel.Text = "STAGE 0 / 0"
    PageLabel.Text = "PAGE 0 / 0"
    SafeSetText(CodeBox, "-- ยังไม่มี source")
    SafeSetText(LogBox, "รอการทำงาน...")
end

-- ===== hooks =====

-- เก็บ loadstring ตัวจริงไว้ใน getgenv กันฮุกซ้อนเวลารันสคริปต์นี้ซ้ำ
local OldLoadstring = Env.__FlexozyOldLoadstring or loadstring
Env.__FlexozyOldLoadstring = OldLoadstring

local function HookedLoadstring(Source, ChunkName)
    if type(Source) == "string" then
        NestedCounter = NestedCounter + 1
        AddLog("loadstring() ถูกเรียก (" .. tostring(#Source) .. " bytes)")
        AddStage("loadstring #" .. tostring(NestedCounter), Source)
    end

    local Fn, Err = OldLoadstring(Source, ChunkName)

    if not Fn then
        AddLog("Compile Error: " .. tostring(Err), true)
        return nil, Err
    end

    return function(...)
        local Packed = table.pack(pcall(Fn, ...))

        if Packed[1] then
            return (unpack or table.unpack)(Packed, 2, Packed.n)
        end

        AddLog("Runtime Error: " .. tostring(Packed[2]), true)
        error(Packed[2], 0)
    end
end

local function InstallLoadstringHook()
    if not OldLoadstring then
        AddLog("ไม่พบ loadstring", true)
        return
    end

    -- ตั้งทั้งใน global env และ env ของสคริปต์นี้ เพื่อให้สคริปต์ขั้นถัดไปโดนจับด้วย
    local Ok, Err = pcall(function()
        Env.loadstring = HookedLoadstring
        loadstring = HookedLoadstring
    end)

    if Ok then
        AddLog("Loadstring Hook พร้อมใช้งาน")
    else
        AddLog("Hook loadstring ไม่สำเร็จ: " .. tostring(Err), true)
    end
end

-- ฮุก game:HttpGet เพื่อจับซอสที่ถูกโหลดมาจาก URL ในแต่ละขั้นตอน
Env.__FlexozyOnHttp = function(Url, Result)
    if type(Result) == "string" and #Result > 0 then
        AddLog("HttpGet: " .. tostring(Url))
        AddStage("HTTP " .. tostring(Url), Result)
    end
end

local function InstallHttpHook()
    if Env.__FlexozyHttpHooked then
        return
    end

    if not hookfunction then
        AddLog("Executor ไม่มี hookfunction — จะจับ HttpGet ไม่ได้ (ยังจับ loadstring ได้)")
        return
    end

    for _, Name in ipairs({"HttpGet", "HttpGetAsync"}) do
        pcall(function()
            local Old
            local Wrapper = function(Self, Url, ...)
                local Result = Old(Self, Url, ...)
                local Callback = Env.__FlexozyOnHttp
                if Callback then
                    pcall(Callback, Url, Result)
                end
                return Result
            end
            if newcclosure then
                Wrapper = newcclosure(Wrapper)
            end
            Old = hookfunction(game[Name], Wrapper)
        end)
    end

    Env.__FlexozyHttpHooked = true
    AddLog("HttpGet Hook พร้อมใช้งาน")
end

local function ExecuteRootSource(Source)
    if Source == "" then
        AddLog("ไม่สามารถ Execute เพราะ Source ว่าง", true)
        return false
    end

    if not OldLoadstring then
        AddLog("Executor ไม่มี loadstring", true)
        return false
    end

    AddLog("กำลัง Compile Source...")

    -- ใช้ตัวจริงตรง ๆ เพื่อไม่ให้ root ถูกนับซ้ำเป็น nested
    local Fn, CompileErr = OldLoadstring(Source)

    if type(Fn) ~= "function" then
        AddLog("Compile Error: " .. tostring(CompileErr), true)
        return false
    end

    AddLog("Compile สำเร็จ")
    AddLog("กำลัง Execute Source...")

    local Ok, Err = pcall(Fn)

    if not Ok then
        AddLog("Runtime Error: " .. tostring(Err), true)
        return false
    end

    AddLog("Execute สำเร็จ")
    return true
end

