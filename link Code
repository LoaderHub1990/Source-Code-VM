local OldLoadstring = loadstring

local RootSource = ""
local CapturedSource = ""
local CapturedChunks = {}

local LoadLogs = {}

local CurrentSourcePage = 1
local SourcePageCount = 0

local IsLoading = false

local function SetStatus(Text, Color)
    if Status and Status.Parent then
        Status.Text = tostring(Text)
        Status.TextColor3 = Color or COLOR_MUTED
    end
end

local function SafeSetText(Object, Text)
    Text = tostring(Text or "")

    if #Text >= 199000 then
        Text = Text:sub(1, 198000)
    end

    pcall(function()
        Object.Text = Text
    end)
end

local function RefreshLog()
    local Text = table.concat(
        LoadLogs,
        "\n"
    )

    if #Text > MAX_LOG_DISPLAY then
        Text = Text:sub(
            #Text - MAX_LOG_DISPLAY + 1
        )
    end

    SafeSetText(
        LogBox,
        Text
    )

    task.defer(function()

        if LogScroll
            and LogScroll.Parent then

            pcall(function()

                LogScroll.CanvasPosition =
                    Vector2.new(
                        0,
                        math.max(
                            0,
                            LogScroll.AbsoluteCanvasSize.Y
                            - LogScroll.AbsoluteSize.Y
                        )
                    )

            end)
        end

    end)
end

local function AddLog(Message, IsError)
    Message = tostring(Message or "")

    table.insert(
        LoadLogs,
        os.date("%H:%M:%S")
        .. "  "
        .. Message
    )

    RefreshLog()

    if IsError then
        SetStatus(
            Message,
            COLOR_ERROR
        )
    end
end

local function RefreshSourcePage()
    if RootSource == "" then

        SafeSetText(
            CodeBox,
            "-- ยังไม่มี source"
        )

        PageLabel.Text = "PAGE 0 / 0"

        return
    end

    SourcePageCount = math.max(
        1,
        math.ceil(
            #RootSource /
            MAX_SOURCE_DISPLAY
        )
    )

    CurrentSourcePage = math.clamp(
        CurrentSourcePage,
        1,
        SourcePageCount
    )

    local StartIndex =
        ((CurrentSourcePage - 1)
        * MAX_SOURCE_DISPLAY) + 1

    local EndIndex =
        math.min(
            StartIndex
            + MAX_SOURCE_DISPLAY
            - 1,
            #RootSource
        )

    local PageSource =
        RootSource:sub(
            StartIndex,
            EndIndex
        )

    SafeSetText(
        CodeBox,
        PageSource
    )

    PageLabel.Text =
        "PAGE "
        .. tostring(CurrentSourcePage)
        .. " / "
        .. tostring(SourcePageCount)

    task.defer(function()

        if CodeScroll
            and CodeScroll.Parent then

            CodeScroll.CanvasPosition =
                Vector2.new(0, 0)

        end

    end)
end

local function SetRootSource(Source)
    Source = tostring(Source or "")

    if Source == "" then
        return
    end

    RootSource = Source
    CapturedSource = Source

    CurrentSourcePage = 1

    RefreshSourcePage()
end

local function CaptureNestedSource(Source)
    Source = tostring(Source or "")

    if Source == "" then
        return
    end

    table.insert(
        CapturedChunks,
        Source
    )

    AddLog(
        "Captured nested source: "
        .. tostring(#Source)
        .. " bytes"
    )
end

local function ClearSession()
    RootSource = ""
    CapturedSource = ""
    CapturedChunks = {}

    CurrentSourcePage = 1
    SourcePageCount = 0

    LoadLogs = {}

    PageLabel.Text = "PAGE 0 / 0"

    SafeSetText(
        CodeBox,
        "-- ยังไม่มี source"
    )

    SafeSetText(
        LogBox,
        "รอการทำงาน..."
    )
end

local function InstallLoadstringHook()

    if not OldLoadstring then

        AddLog(
            "ไม่พบ loadstring",
            true
        )

        return
    end

    local HookSuccess,
        HookError =
        pcall(function()

            loadstring = function(Source)

                Source = tostring(Source or "")

                AddLog(
                    "loadstring() ถูกเรียก"
                )

                AddLog(
                    "Source Size: "
                    .. tostring(#Source)
                    .. " bytes"
                )

                CaptureNestedSource(Source)

                local CompileSuccess,
                    CompileResult =
                    pcall(function()

                        return OldLoadstring(
                            Source
                        )

                    end)

                if not CompileSuccess then

                    AddLog(
                        "Compile Error: "
                        .. tostring(
                            CompileResult
                        ),
                        true
                    )

                    return nil
                end

                AddLog(
                    "Compile สำเร็จ"
                )

                if type(
                    CompileResult
                ) ~= "function" then

                    AddLog(
                        "Compile สำเร็จ แต่ไม่ใช่ function"
                    )

                    return CompileResult
                end

                local OriginalFunction =
                    CompileResult

                return function(...)

                    local Arguments = {...}
                    local Unpack =
                        unpack or table.unpack

                    AddLog(
                        "Execute เริ่มทำงาน"
                    )

                    local ExecuteSuccess,
                        ExecuteResult =
                        pcall(function()

                            return OriginalFunction(
                                Unpack(Arguments)
                            )

                        end)

                    if ExecuteSuccess then

                        AddLog(
                            "Execute สำเร็จ"
                        )

                        return ExecuteResult
                    end

                    AddLog(
                        "Runtime Error: "
                        .. tostring(
                            ExecuteResult
                        ),
                        true
                    )

                    error(
                        ExecuteResult,
                        0
                    )
                end
            end

        end)

    if HookSuccess then

        AddLog(
            "Loadstring Hook พร้อมใช้งาน"
        )

    else

        AddLog(
            "Hook loadstring ไม่สำเร็จ: "
            .. tostring(HookError),
            true
        )

    end
end

local function ExecuteRootSource(Source)

    Source = tostring(Source or "")

    if Source == "" then

        AddLog(
            "ไม่สามารถ Execute เพราะ Source ว่าง",
            true
        )

        return false
    end

    if not OldLoadstring then

        AddLog(
            "Executor ไม่มี loadstring",
            true
        )

        return false
    end

    AddLog(
        "กำลัง Compile Source..."
    )

    local CompileSuccess,
        CompileResult =
        pcall(function()

            return loadstring(Source)

        end)

    if not CompileSuccess then

        AddLog(
            "Compile Error: "
            .. tostring(CompileResult),
            true
        )

        return false
    end

    if type(
        CompileResult
    ) ~= "function" then

        AddLog(
            "Compile สำเร็จ แต่ผลลัพธ์ไม่ใช่ function",
            true
        )

        return false
    end

    AddLog(
        "Compile สำเร็จ"
    )

    AddLog(
        "กำลัง Execute Source..."
    )

    local ExecuteSuccess,
        ExecuteResult =
        pcall(function()

            return CompileResult()

        end)

    if not ExecuteSuccess then

        AddLog(
            "Runtime Error: "
            .. tostring(ExecuteResult),
            true
        )

        return false
    end

    AddLog(
        "Execute สำเร็จ"
    )

    return true
end

