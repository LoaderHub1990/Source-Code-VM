local function UpdateScale()
    local Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    local Viewport = Camera.ViewportSize

    local X = (Viewport.X - 30) / 760
    local Y = (Viewport.Y - 30) / 500

    Scale.Scale = math.clamp(
        math.min(X, Y),
        0.45,
        1
    )
end

